# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See ref/kashmirbnb_supabase_implementation_checklist (1).md Phase 0 for context.

# Supabase — https://supabase.com/docs/guides/getting-started/api-keys
# Publishable/secret keys are the current format; legacy anon/service_role
# JWT keys keep working until end of 2026 and are supported as a fallback.

# Supabase — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (deprecated end of 2026): NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only, bypasses Row Level Security
SUPABASE_SECRET_KEY=
# Legacy fallback (deprecated end of 2026): SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional — approved Meta authentication template name for OTP delivery.
# Defaults to "otp_verification" in code if unset.
WHATSAPP_OTP_TEMPLATE_NAME=

# OTP delivery fallbacks
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Phone.Email fallback (https://www.phone.email/docs-sign-in-with-phone) —
# used only when WhatsApp/SMS OTP delivery fails. The frontend integration
# (generated-button vs React phone-email-auth) and its client ID are
# dashboard-generated and will be supplied by the TL; do not invent values
# here. NEXT_PUBLIC_* values are exposed to the browser by Next.js — never
# put a secret in one.
NEXT_PUBLIC_PHONE_EMAIL_ENABLED=
# One of: generated_button | react_client (leave unset to keep the fallback
# adapter in its "unconfigured" state)
NEXT_PUBLIC_PHONE_EMAIL_PROVIDER_MODE=
NEXT_PUBLIC_PHONE_EMAIL_CLIENT_ID=
# Server-only allowlist for the user_json_url host the backend is willing
# to fetch (SSRF guard). Defaults to user.phone.email in code — only set
# this to point at a Phone.Email staging/test host if the TL confirms one.
PHONE_EMAIL_USER_JSON_ALLOWED_HOST=

# Shared secret for authenticating scheduled/cron-triggered route handlers
CRON_SECRET=

# Shared secret for internal admin routes (app/api/admin/**). No admin
# login/session system exists yet — this is a lightweight bearer-token gate,
# same pattern as CRON_SECRET, until real admin auth is built.
ADMIN_API_SECRET=

# Edge Function secrets (Checklist Phase 3 / supabase/functions/**) —
# NOTE: Edge Functions run in Deno and do NOT read .env.local. Set these
# separately via `supabase secrets set --env-file .env.local` (or the
# dashboard) after filling in real values above: WHATSAPP_ACCESS_TOKEN,
# WHATSAPP_PHONE_NUMBER_ID, SMS_PROVIDER_API_KEY, EMAIL_PROVIDER_API_KEY.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into every
# Edge Function's environment and do not need to be set manually.
