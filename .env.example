# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See ref/kashmirbnb_supabase_implementation_checklist (1).md Phase 0 for context.

# Supabase — https://supabase.com/docs/guides/getting-started/api-keys
# Publishable/secret keys are the current format; legacy anon/service_role
# JWT keys keep working until end of 2026 and are supported as a fallback.

# Supabase — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback (deprecated end of 2026): NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — server-only, bypasses Row Level Security
SUPABASE_SECRET_KEY=
# Legacy fallback (deprecated end of 2026): SUPABASE_SERVICE_ROLE_KEY=

# Supabase — database password for one-off migrations (NOT the secret API key).
# Dashboard → Project Settings → Database → Database password
# Used by: npm run db:templates
# SUPABASE_DB_PASSWORD=
# Or full pooler URL: SUPABASE_DB_URL=postgresql://postgres.[ref]:[password]@...pooler.supabase.com:5432/postgres

# Local demo — NEVER set true in production. Skips MSG91/WhatsApp OTP delivery;
# POST /api/otp/send stores a fixed code (123456) and the normal verify path runs.
# After OTP verify, fake WhatsApp quote cards are auto-sent (no cron/Meta needed).
# Enables /admin/debug ops console + faster 1.5s dispatch animation.
# Requires vendor fixture data — run `npm run db:seed` (or supabase db reset).
DEMO_MODE=

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Optional — approved Meta authentication template name for OTP delivery.
# Defaults to "otp_verification" in code if unset.
WHATSAPP_OTP_TEMPLATE_NAME=

# MSG91 WhatsApp — primary outbound provider when both vars are set (quotes,
# negotiation, lifecycle, OTP retry). Uses control.msg91.com bulk template +
# session/interactive APIs per docs.msg91.com/whatsapp. Falls back to Meta
# Graph only when MSG91 vars are empty. OTP SMS uses SendOTP:
# MSG91_AUTH_KEY + MSG91_OTP_TEMPLATE_ID. WhatsApp OTP retry is explicit
# (prefer=whatsapp). Keep WHATSAPP_* as fallback until Phase 5 cleanup.
MSG91_AUTH_KEY=
MSG91_WHATSAPP_INTEGRATED_NUMBER=
# Required for POST /api/whatsapp/webhook (header x-msg91-webhook-secret).
# MSG91 cannot reach localhost — use a public HTTPS tunnel or Vercel URL.
MSG91_WEBHOOK_SECRET=
# true/yes/1 (default if unset): send approved MSG91 Utility templates (bulk).
# false/no/0: skip bulk templates; send session text / interactive instead.
# SMS OTP and Cashfree payment_link are never affected. Not DEMO_MODE —
# this still talks to real MSG91. Session APIs require an open 24h WhatsApp
# window (SMS OTP does not open one). See docs/msg91-whatsapp-integration.md.
MSG91_USE_APPROVED_TEMPLATES=
MSG91_OTP_TEMPLATE_NAME=
# Defaults to otp_verification in code if unset — not a Green approval claim.
MSG91_OTP_TEMPLATE_NAMESPACE=
MSG91_OTP_TEMPLATE_LANGUAGE=
MSG91_OTP_TEMPLATE_ID=
# Cashfree — ₹99 token payment. Both of Cashfree's automated per-booking
# paths are blocked on this merchant account: MSG91's `payment_link`
# (Cashfree Orders/S2S) by `s2s_enabled_not_approved`, and Cashfree's own
# dynamic Payment Links create-API (`POST /pg/links`) by
# `link_creation_api is not enabled or approved`. Every token payment now
# sends one dashboard-created static link instead (see
# lib/whatsapp/tokenPaymentLink.ts STATIC_TOKEN_PAYMENT_LINK_URL and
# docs/cashfree-payment-links-workaround.md) — no Cashfree env vars are
# required to send it.
# Only needed if app/api/cashfree/webhook stays enabled to verify + log
# (audit-only, not auto-confirming) payment events Cashfree sends for that
# static link from its dashboard. A `cfsk_ma_prod...` secret is a
# PRODUCTION key.
CASHFREE_SECRET_KEY=

# Optional utility templates (create per docs/msg91-whatsapp-dashboard-templates.md)
MSG91_VENDOR_NOTIFY_TEMPLATE_NAME=
MSG91_VENDOR_NOTIFY_TEMPLATE_NAMESPACE=
MSG91_QUOTE_SINGLE_TEMPLATE_NAME=
MSG91_QUOTE_SINGLE_TEMPLATE_NAMESPACE=
MSG91_QUOTE_MULTI_TEMPLATE_NAME=
MSG91_QUOTE_MULTI_TEMPLATE_NAMESPACE=
MSG91_DRIVER_BALANCE_TEMPLATE_NAME=
MSG91_DRIVER_BALANCE_TEMPLATE_NAMESPACE=
MSG91_CONFIRMATION_TEMPLATE_NAME=
MSG91_CONFIRMATION_TEMPLATE_NAMESPACE=
MSG91_PRE_PICKUP_TEMPLATE_NAME=
MSG91_PRE_PICKUP_TEMPLATE_NAMESPACE=
MSG91_DRIVER_CONTACT_TEMPLATE_NAME=
MSG91_DRIVER_CONTACT_TEMPLATE_NAMESPACE=

# OTP delivery fallbacks
SMS_PROVIDER_API_KEY=
EMAIL_PROVIDER_API_KEY=

# Phone.Email fallback (https://www.phone.email/docs-sign-in-with-phone) —
# used when SMS SendOTP (or WhatsApp OTP retry) fails. NEXT_PUBLIC_* values are
# exposed to the browser by Next.js — never put a secret in one.
NEXT_PUBLIC_PHONE_EMAIL_ENABLED=
# One of: access_token | generated_button | react_client (leave unset to
# keep the fallback adapter in its "unconfigured" state). access_token is
# the implemented "Login with Phone" popup flow: CLIENT_ID + access_token
# + eapi.phone.email/getuser + ph_email_jwt validation.
NEXT_PUBLIC_PHONE_EMAIL_PROVIDER_MODE=
# Browser-side CLIENT_ID used to build the Phone.Email auth popup URL.
# From the Phone.Email admin dashboard → Profile Details.
NEXT_PUBLIC_PHONE_EMAIL_CLIENT_ID=
# Server-only mirror of the same CLIENT_ID, used when the backend calls
# eapi.phone.email/getuser. Kept separate from the NEXT_PUBLIC_ copy so the
# server never depends on a browser-supplied client id.
PHONE_EMAIL_CLIENT_ID=
# Server-only API Key from the same Profile Details section — used only to
# validate the ph_email_jwt returned by getuser. Never expose to the browser.
PHONE_VERIFICATION_API_KEY=
# Server-only allowlist for the user_json_url host the backend is willing
# to fetch (SSRF guard). Defaults to user.phone.email in code — only set
# this to point at a Phone.Email staging/test host if the TL confirms one.
PHONE_EMAIL_USER_JSON_ALLOWED_HOST=

# Shared secret for authenticating scheduled/cron-triggered route handlers
CRON_SECRET=

# Shared secret for internal admin routes (app/api/admin/**). No admin
# login/session system exists yet — this is a lightweight bearer-token gate,
# same pattern as CRON_SECRET, until real admin auth is built.
ADMIN_API_SECRET=

# Edge Function secrets (Checklist Phase 3 / supabase/functions/**) —
# NOTE: Edge Functions run in Deno and do NOT read .env.local. Set these
# separately via `supabase secrets set --env-file .env.local` (or the
# dashboard) after filling in real values above. Edge Functions prefer
# MSG91_AUTH_KEY + MSG91_WHATSAPP_INTEGRATED_NUMBER for outbound WhatsApp;
# WHATSAPP_ACCESS_TOKEN + WHATSAPP_PHONE_NUMBER_ID remain Meta fallback.
# Also: SMS_PROVIDER_API_KEY,
# EMAIL_PROVIDER_API_KEY.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are auto-injected into every
# Edge Function's environment and do not need to be set manually.
#
# Optional — read by expire-stale-quotes (Checklist 3.9). Defaults to 48 in
# code if unset.
QUOTE_EXPIRY_HOURS=
# Optional — read by send-confirmation-card (Checklist 3.7) when scheduling
# the midtrip_wellness lifecycle event. Defaults to 3 in code if unset.
MIDTRIP_WELLNESS_MIN_DAYS=
# Optional — read by ops-alert (Checklist 3.10 / Phase 3 final pass). Any
# provider that accepts a JSON POST webhook (Slack incoming webhook, a
# relay, a custom ops dashboard) can be pointed at this. Falls back to
# console logging when unset.
OPS_ALERT_WEBHOOK_URL=
# Optional — read by vendor-reply-timeouts (Plan §9). Minutes a booking may
# stay in vendor_confirming/vendor_confirmed/driver_attach_pending before
# escalating to ops. Defaults to 30 in code if unset.
VENDOR_DRIVER_DETAIL_SLA_MINUTES=
# Optional — read by send-confirmation-card (Checklist 3.7 / Plan §6.4).
# Public HTTPS image URLs (not secrets) for the confirmation card image.
# CONFIRMATION_CARD_IMAGE_URL_<VEHICLE_CODE_UPPER> (e.g. _SEDAN, _SUV,
# _TEMPO) takes priority over the generic fallback below. Leave unset to
# keep confirmation cards text-only.
CONFIRMATION_CARD_IMAGE_URL=
CONFIRMATION_CARD_IMAGE_URL_SEDAN=
CONFIRMATION_CARD_IMAGE_URL_SUV=
CONFIRMATION_CARD_IMAGE_URL_TEMPO=
